# 仅把这些非秘密字段合并到 C:\stockdata\stock_server\.env。
# 不要用本文件覆盖现有生产 .env；生产密码、Token、证书共享密钥保持原值。
DEPLOYMENT_SLOT=production
ENVIRONMENT_GUARD_ENABLED=True
EXPECTED_PROJECT_ROOT=C:\stockdata\stock_server
EXPECTED_SERVER_PORT=8899
EXPECTED_REDIS_DB=0
EXPECTED_REDIS_KEY_PREFIX=stock_server
EXPECTED_ADMIN_HOST=admin-api.lifesupermarket.cn

APP_ENV=production
SERVER_HOST=127.0.0.1
SERVER_PORT=8899
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=stock_server
ADMIN_CLIENT_CERT_ADMIN_HOST=admin-api.lifesupermarket.cn
