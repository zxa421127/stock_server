# 合并到 C:\stockdata\stock_server_test\.env；所有密钥、Token、飞书表和 CA 必须为测试专用。
DEPLOYMENT_SLOT=test
ENVIRONMENT_GUARD_ENABLED=True
EXPECTED_PROJECT_ROOT=C:\stockdata\stock_server_test
EXPECTED_SERVER_PORT=8898
EXPECTED_REDIS_DB=3
EXPECTED_REDIS_KEY_PREFIX=stock_server_test
EXPECTED_ADMIN_HOST=test-admin-api.lifesupermarket.cn

APP_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=8898
DATA_DIR=data
DB_FILE=data/tokens.db
LOG_DIR=logs
REDIS_URL=redis://127.0.0.1:6379/3
REDIS_KEY_PREFIX=stock_server_test
ADMIN_CLIENT_CERT_REQUIRED=True
ADMIN_CLIENT_CERT_ADMIN_HOST=test-admin-api.lifesupermarket.cn
