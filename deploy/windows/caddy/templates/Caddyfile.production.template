lifesupermarket.cn, www.lifesupermarket.cn {
	encode zstd gzip

	reverse_proxy 127.0.0.1:8080

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output file C:/caddy/logs/lifesupermarket_access.log {
			roll_size 50MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
}

api.lifesupermarket.cn {
	encode zstd gzip

	route {
		@admin_paths path /admin /admin/*
		respond @admin_paths 404

		reverse_proxy 127.0.0.1:8899 {
			header_up -X-Admin-*
		}
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output file C:/caddy/logs/api_access.log {
			roll_size 50MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
}

test-api.lifesupermarket.cn {
	encode zstd gzip

	route {
		@admin_paths path /admin /admin/*
		respond @admin_paths 404

		reverse_proxy 127.0.0.1:8898 {
