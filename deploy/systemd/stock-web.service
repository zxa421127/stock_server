[Unit]
Description=Stock Server Web API
After=network-online.target redis-server.service
Wants=network-online.target
Requires=redis-server.service

[Service]
Type=simple
User=stockserver
Group=stockserver
WorkingDirectory=/opt/stock-server
EnvironmentFile=/etc/stock-server/stock-server.env
ExecStartPre=/opt/stock-server/.venv/bin/python -m tools.production_preflight
ExecStart=/opt/stock-server/.venv/bin/gunicorn -c gunicorn.conf.py wsgi:app
ExecReload=/bin/kill -s HUP $MAINPID
KillSignal=SIGTERM
TimeoutStopSec=45
Restart=on-failure
RestartSec=3
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/stock-server/data /opt/stock-server/logs /opt/stock-server/interface_specs
UMask=0077
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
