[Unit]
Description=Stock Server Feishu Sync Worker
After=network-online.target stock-web.service

[Service]
Type=simple
User=stockserver
Group=stockserver
WorkingDirectory=/opt/stock-server
EnvironmentFile=/etc/stock-server/stock-server.env
ExecStart=/opt/stock-server/.venv/bin/python -m tools.feishu_worker
Restart=on-failure
RestartSec=10
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/stock-server/data /opt/stock-server/logs
UMask=0077

[Install]
WantedBy=multi-user.target
