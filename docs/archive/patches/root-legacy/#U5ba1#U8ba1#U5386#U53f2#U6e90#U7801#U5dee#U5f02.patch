+.panel,.stats{{background:white;border:1px solid #d0d5dd;border-radius:10px;padding:14px;margin-bottom:14px}}
+.stats{{display:flex;gap:12px;flex-wrap:wrap}} .stat{{min-width:125px;padding:10px;background:#f9fafb;border-radius:8px}}
