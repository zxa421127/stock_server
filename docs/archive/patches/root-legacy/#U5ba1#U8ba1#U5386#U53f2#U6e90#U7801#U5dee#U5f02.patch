+def _page_args() -> tuple[int, int]:
+    try:
+        page = max(1, int(request.args.get("page", "1")))
+    except ValueError:
+        page = 1
+    try:
+        page_size = int(request.args.get("page_size", "50"))
+    except ValueError:
+        page_size = 50
+    return page, page_size
