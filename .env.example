# PLATFORM_POLICY_ENV_EXAMPLE_SINGLE_SOURCE_V1
# Shared non-secret tunables are configured only in settings/platform_policy.json.
# Lines ending with 'managed in settings/platform_policy.json' are documentation only, not editable values.

# ==============================================================================
# 配置模板（不包含真实凭证，复制为 .env 后再填写）
# 每个配置项上方都有说明；等号右侧才是实际值。不要删除等号。
# ==============================================================================

# ------------------------------------------------------------------------------
# 运行环境与 Tushare
# ------------------------------------------------------------------------------
# 运行模式；本地使用 development，正式服务器使用 production。
APP_ENV=production

# 部署槽身份；腾讯云正式目录填写 production，腾讯云测试目录填写 test。
DEPLOYMENT_SLOT=

# 是否启用目录/端口/DB/Redis/管理员域名防串线。完成下面 EXPECTED_* 配置后设为 True。
ENVIRONMENT_GUARD_ENABLED=False

# 当前 .env 允许启动的唯一项目根目录，例如 C:\stockdata\stock_server。
EXPECTED_PROJECT_ROOT=

# 当前部署槽允许的唯一端口，例如生产 8899、腾讯云测试 8898。
EXPECTED_SERVER_PORT=0

# 当前部署槽允许的 Redis 逻辑库，例如生产 0、腾讯云测试 3。
EXPECTED_REDIS_DB=-1

# 必须与 REDIS_KEY_PREFIX 完全一致；测试环境应使用独立前缀。
EXPECTED_REDIS_KEY_PREFIX=

# 必须与 ADMIN_CLIENT_CERT_ADMIN_HOST 完全一致。
EXPECTED_ADMIN_HOST=


# 服务器调用 Tushare 或中转服务使用的真实 Token；不是用户的 X-API-Token。
TUSHARE_TOKEN=

# 自定义 Tushare 中转地址；留空表示使用官方 SDK。当前本地保留你的原地址，生产环境必须改为 HTTPS。
TUSHARE_API_URL=

# Tushare 请求总超时时间，单位秒。
TUSHARE_TIMEOUT_SECONDS=30

# 允许访问的中转主机白名单，多个域名或 IP 用英文逗号分隔。
TUSHARE_ALLOWED_RELAY_HOSTS=

# 连接 Tushare 中转服务的超时时间，单位秒。
TUSHARE_CONNECT_TIMEOUT_SECONDS=5

# 允许中转服务返回的最大响应体字节数。
TUSHARE_MAX_RESPONSE_BYTES=33554432

# ------------------------------------------------------------------------------
# Web 服务与响应限制
# ------------------------------------------------------------------------------
# Web 服务监听地址；127.0.0.1 表示只允许本机访问。
SERVER_HOST=127.0.0.1

# Web 服务监听端口。
SERVER_PORT=8899

# Waitress 工作线程数。
# SERVER_THREADS=managed in settings/platform_policy.json

# Linux Gunicorn 工作进程数。
GUNICORN_WORKERS=4

# 每个 Gunicorn 进程的线程数。
GUNICORN_THREADS=8

# Gunicorn 单次请求超时时间，单位秒。
GUNICORN_TIMEOUT=60

# Waitress 可同时维护的最大连接数。
# WAITRESS_CONNECTION_LIMIT=managed in settings/platform_policy.json

# Waitress 空闲连接超时时间，单位秒。
# WAITRESS_CHANNEL_TIMEOUT=managed in settings/platform_policy.json

# 是否记录每个 HTTP 请求的访问日志。
ENABLE_HTTP_ACCESS_LOG=False

# 单个 HTTP 请求体最大字节数。
# MAX_REQUEST_BODY_BYTES=managed in settings/platform_policy.json

# 单次 API 响应允许的最大数据行数。
# API_MAX_RESPONSE_ROWS=managed in settings/platform_policy.json

# 单接口响应行数覆盖；全市场/大截面接口可定向放宽。未列出的接口仍使用 API_MAX_RESPONSE_ROWS。
# API_MAX_RESPONSE_ROWS_OVERRIDES=managed in settings/platform_policy.json

# 单次 API JSON 响应允许的最大字节数。
# API_MAX_RESPONSE_BYTES=managed in settings/platform_policy.json

# Flask Session、CSRF 和验证码签名密钥；部署后必须保持稳定且不能公开。
SECRET_KEY=

# 允许浏览器跨域调用 API 的来源列表，多个地址用英文逗号分隔。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Redis、总限流与认证缓存
# ------------------------------------------------------------------------------
# Redis 连接地址。
REDIS_URL=redis://127.0.0.1:6379/0

# Redis 不可用时是否拒绝启动或拒绝关键请求；本地可 False，生产应 True。
REDIS_REQUIRED=True

# 本项目写入 Redis 的键名前缀，避免与其他项目冲突。
REDIS_KEY_PREFIX=stock_server

# 连接 Redis 的超时时间，单位秒。
REDIS_CONNECT_TIMEOUT_SECONDS=1.0

# Redis 读写超时时间，单位秒。
REDIS_SOCKET_TIMEOUT_SECONDS=1.0

# 套餐没有单独配置时的默认每分钟请求上限。
# DEFAULT_REQUESTS_PER_MINUTE=managed in settings/platform_policy.json

# 每分钟额度兼容下限；公开套餐使用 plan_catalog 的显式额度，保持 1。
# MIN_REQUESTS_PER_MINUTE=managed in settings/platform_policy.json

# 整个服务每秒允许的全局请求上限。
# GLOBAL_REQUESTS_PER_SECOND=managed in settings/platform_policy.json

# Token 鉴权上下文的缓存时间，单位秒。
AUTH_CONTEXT_CACHE_TTL_SECONDS=30

# ------------------------------------------------------------------------------
# 管理员、安全 Cookie 与反向代理
# ------------------------------------------------------------------------------
# 管理员登录用户名。
ADMIN_USERNAME=admin

# 仅用于本地开发的管理员明文密码；生产环境必须留空。
ADMIN_PASSWORD=

# 生产管理员 PBKDF2 密码哈希；生产环境必须填写。
ADMIN_PASSWORD_HASH=

# 是否要求管理员通过 mTLS 客户端证书访问后台。
ADMIN_CLIENT_CERT_REQUIRED=True

# 应用与受信任反向代理之间验证管理员证书头的共享密钥。
ADMIN_CLIENT_CERT_PROXY_SECRET=

# 管理员后台专用域名。
ADMIN_CLIENT_CERT_ADMIN_HOST=admin-api.example.com

# 受信任反向代理传递客户端证书验证结果的请求头名称。
ADMIN_CLIENT_CERT_VERIFY_HEADER=X-Admin-Client-Cert-Verify

# Nginx 传递 URL 转义 PEM 客户端证书的请求头名称。
ADMIN_CLIENT_CERT_PEM_HEADER=X-Admin-Client-Cert

# Caddy 传递 Base64 DER 客户端证书的请求头名称。
ADMIN_CLIENT_CERT_DER_HEADER=X-Admin-Client-Cert-DER

# 受信任反向代理传递客户端证书指纹的请求头名称。
ADMIN_CLIENT_CERT_FINGERPRINT_HEADER=X-Admin-Client-Cert-Fingerprint

# 受信任反向代理传递客户端证书序列号的请求头名称。
ADMIN_CLIENT_CERT_SERIAL_HEADER=X-Admin-Client-Cert-Serial

# 受信任反向代理传递客户端证书主题的请求头名称。
ADMIN_CLIENT_CERT_SUBJECT_HEADER=X-Admin-Client-Cert-Subject

# 受信任反向代理传递代理共享密钥的请求头名称。
ADMIN_CLIENT_CERT_PROXY_HEADER=X-Admin-Proxy-Auth

# 管理员登录图形验证码字符数。
ADMIN_CAPTCHA_LENGTH=5

# 管理员验证码有效期，单位秒。
# ADMIN_CAPTCHA_TTL_SECONDS=managed in settings/platform_policy.json

# 管理员验证码图片宽度，单位像素。
ADMIN_CAPTCHA_WIDTH=180

# 管理员验证码图片高度，单位像素。
ADMIN_CAPTCHA_HEIGHT=58

# 旧 TOTP 多因素认证兼容开关；使用 mTLS 时保持 False。
ADMIN_REQUIRE_MFA=False

# 旧 TOTP 密钥；正常部署留空。
ADMIN_TOTP_SECRET=

# API Token HMAC 摘要专用密钥，不能与 SECRET_KEY 共用。
API_TOKEN_HASH_SECRET=

# 管理员允许访问的 IP 白名单；留空表示不额外限制。
ADMIN_IP_WHITELIST=

# 是否只通过 HTTPS 发送 Session Cookie；本地 HTTP 为 False，生产必须 True。
SESSION_COOKIE_SECURE=True

# 登录 Session 有效时间，单位分钟。
SESSION_LIFETIME_MINUTES=480

# 是否允许不安全默认密钥；应始终保持 False。
ALLOW_INSECURE_DEFAULTS=False

# 是否允许 Python 服务直接监听公网地址；建议始终 False。
ALLOW_DIRECT_PUBLIC_BIND=False

# 是否强制定时任务使用独立 Worker；生产应 True。
REQUIRE_EXTERNAL_WORKERS=True

# 是否信任 Nginx 的 X-Forwarded-* 请求头；仅可信代理后开启。
TRUST_PROXY_HEADERS=True

# 信任的 X-Forwarded-For 代理层数。
PROXY_FIX_X_FOR=1

# 信任的 X-Forwarded-Proto 代理层数。
PROXY_FIX_X_PROTO=1

# 信任的 X-Forwarded-Host 代理层数。
PROXY_FIX_X_HOST=0

# AD最小 LOGIN 最大 FAILURES；一般保持当前默认值，仅在明确需要调优时修改。
ADMIN_LOGIN_MAX_FAILURES=5

# AD最小 LOGIN 统计窗口 秒数；一般保持当前默认值，仅在明确需要调优时修改。
ADMIN_LOGIN_WINDOW_SECONDS=900

# AD最小 LOGIN 锁定 秒数；一般保持当前默认值，仅在明确需要调优时修改。
ADMIN_LOGIN_LOCK_SECONDS=900

# ------------------------------------------------------------------------------
# 用户输入、注册、邮箱和短信验证
# ------------------------------------------------------------------------------
# 用户密码最小长度。
# USER_PASSWORD_MIN_LENGTH=managed in settings/platform_policy.json

# 用户名最小长度。
USER_USERNAME_MIN_LENGTH=3

# 用户名最大长度。
USER_USERNAME_MAX_LENGTH=64

# 用户密码最大长度；用于避免超长密码消耗 CPU。
USER_PASSWORD_MAX_LENGTH=128

# 邮箱地址最大长度。
USER_EMAIL_MAX_LENGTH=254

# 手机号最大长度。
USER_PHONE_MAX_LENGTH=32

# 登录账号输入最大长度。
USER_ACCOUNT_MAX_LENGTH=254

# 找回密码联系方式最大长度。
PASSWORD_RESET_CONTACT_MAX_LENGTH=254

# REGISTRATION GLOBAL 最大 REQUESTS；一般保持当前默认值，仅在明确需要调优时修改。
REGISTRATION_GLOBAL_MAX_REQUESTS=30

# REGISTRATION GLOBAL 统计窗口 秒数；一般保持当前默认值，仅在明确需要调优时修改。
REGISTRATION_GLOBAL_WINDOW_SECONDS=60

# REGISTRATION GLOBAL 锁定 秒数；一般保持当前默认值，仅在明确需要调优时修改。
REGISTRATION_GLOBAL_LOCK_SECONDS=60

# REGISTRATION CAPTCHA LENGTH；一般保持当前默认值，仅在明确需要调优时修改。
REGISTRATION_CAPTCHA_LENGTH=5

# REGISTRATION CAPTCHA 有效期 秒数；一般保持当前默认值，仅在明确需要调优时修改。
# REGISTRATION_CAPTCHA_TTL_SECONDS=managed in settings/platform_policy.json

# 注册时是否必须通过邮箱或短信验证联系方式。
REGISTRATION_CONTACT_VERIFICATION_REQUIRED=True

# 是否允许使用邮箱验证码完成注册。
REGISTRATION_EMAIL_VERIFICATION_ENABLED=True

# 是否允许使用短信 Webhook 验证码完成注册。
REGISTRATION_SMS_VERIFICATION_ENABLED=False

# 邮箱和短信验证码摘要专用 HMAC 密钥。
CONTACT_VERIFICATION_HMAC_SECRET=

# CONTACT CODE 有效期 秒数；一般保持当前默认值，仅在明确需要调优时修改。
# CONTACT_CODE_TTL_SECONDS=managed in settings/platform_policy.json

# CONTACT CODE 最大 ATTEMPTS；一般保持当前默认值，仅在明确需要调优时修改。
CONTACT_CODE_MAX_ATTEMPTS=5

# CONTACT CODE RESEND 秒数；一般保持当前默认值，仅在明确需要调优时修改。
CONTACT_CODE_RESEND_SECONDS=60

# 发送注册验证码邮件的 SMTP 服务器地址。
SMTP_HOST=

# SMTP 服务器端口。
SMTP_PORT=587

# SMTP 登录用户名；本地调试服务可留空。
SMTP_USERNAME=

# SMTP 登录密码或授权码；本地调试服务可留空。
SMTP_PASSWORD=

# 验证码邮件的发件人地址。
SMTP_FROM_ADDRESS=

# 是否使用 STARTTLS。
SMTP_USE_TLS=True

# 是否从连接开始直接使用 SSL。
SMTP_USE_SSL=False

# SMTP 连接和发送超时时间，单位秒。
SMTP_TIMEOUT_SECONDS=10

# 通用短信发送 Webhook 地址；未启用短信时留空。
SMS_VERIFY_WEBHOOK_URL=

# 短信 Webhook 请求签名密钥；未启用短信时留空。
SMS_VERIFY_WEBHOOK_SECRET=

# 短信 Webhook 请求超时时间，单位秒。
SMS_VERIFY_TIMEOUT_SECONDS=10

# USER REGISTRATION 最大 REQUESTS；一般保持当前默认值，仅在明确需要调优时修改。
USER_REGISTRATION_MAX_REQUESTS=5

# USER REGISTRATION 统计窗口 秒数；一般保持当前默认值，仅在明确需要调优时修改。
USER_REGISTRATION_WINDOW_SECONDS=3600

# USER REGISTRATION 锁定 秒数；一般保持当前默认值，仅在明确需要调优时修改。
USER_REGISTRATION_LOCK_SECONDS=3600

# USER LOGIN 最大 FAILURES；一般保持当前默认值，仅在明确需要调优时修改。
USER_LOGIN_MAX_FAILURES=8

# USER LOGIN 统计窗口 秒数；一般保持当前默认值，仅在明确需要调优时修改。
USER_LOGIN_WINDOW_SECONDS=900

# USER LOGIN 锁定 秒数；一般保持当前默认值，仅在明确需要调优时修改。
USER_LOGIN_LOCK_SECONDS=900

# PASSWORD RESET 最大 REQUESTS；一般保持当前默认值，仅在明确需要调优时修改。
PASSWORD_RESET_MAX_REQUESTS=3

# PASSWORD RESET 统计窗口 秒数；一般保持当前默认值，仅在明确需要调优时修改。
PASSWORD_RESET_WINDOW_SECONDS=3600

# PASSWORD RESET 锁定 秒数；一般保持当前默认值，仅在明确需要调优时修改。
PASSWORD_RESET_LOCK_SECONDS=3600

# 页面显示的管理员联系 QQ。
CONTACT_QQ=

# 页面显示的管理员联系微信。
CONTACT_WECHAT=

# 页面显示的套餐开通联系说明。
CONTACT_NOTE=如需开通接口套餐，请联系管理员开通对应权限和有效期。

# ------------------------------------------------------------------------------
# 数据库
# ------------------------------------------------------------------------------
# 业务数据目录。
DATA_DIR=data

# SQLite 主数据库文件路径。
DB_FILE=data/stock_server.db

# 更新 API Key 最近使用时间的最小间隔，单位秒。
# API_KEY_TOUCH_INTERVAL_SECONDS=managed in settings/platform_policy.json

# 启动时是否自动迁移数据库；本地可 True，生产应 False 并手工迁移。
DB_AUTO_MIGRATE=False

# ------------------------------------------------------------------------------
# 行情缓存与调用日志
# ------------------------------------------------------------------------------
# MARKET DATA CACHE 是否启用；一般保持当前默认值，仅在明确需要调优时修改。
# MARKET_DATA_CACHE_ENABLED=managed in settings/platform_policy.json

# MARKET DATA CACHE 有效期 秒数；一般保持当前默认值，仅在明确需要调优时修改。
# MARKET_DATA_CACHE_TTL_SECONDS=managed in settings/platform_policy.json

# MARKET DATA CACHE 最大 ITEMS；一般保持当前默认值，仅在明确需要调优时修改。
# MARKET_DATA_CACHE_MAX_ITEMS=managed in settings/platform_policy.json

# MARKET DATA CACHE EXCLUDE APIS；一般保持当前默认值，仅在明确需要调优时修改。
# MARKET_DATA_CACHE_EXCLUDE_APIS=managed in settings/platform_policy.json

# MARKET DATA CACHE 有效期 OVERRIDES；一般保持当前默认值，仅在明确需要调优时修改。
# MARKET_DATA_CACHE_TTL_OVERRIDES=managed in settings/platform_policy.json

# MARKET DATA EMPTY CACHE 有效期 秒数；一般保持当前默认值，仅在明确需要调优时修改。
# MARKET_DATA_EMPTY_CACHE_TTL_SECONDS=managed in settings/platform_policy.json

# MARKET DATA STALE IF ERROR 秒数；一般保持当前默认值，仅在明确需要调优时修改。
# MARKET_DATA_STALE_IF_ERROR_SECONDS=managed in settings/platform_policy.json

# MARKET DATA STALE IF ERROR APIS；一般保持当前默认值，仅在明确需要调优时修改。
# MARKET_DATA_STALE_IF_ERROR_APIS=managed in settings/platform_policy.json

# MARKET DATA BACKGROUND REFRESH 是否启用；一般保持当前默认值，仅在明确需要调优时修改。
MARKET_DATA_BACKGROUND_REFRESH_ENABLED=True

# MARKET DATA BACKGROUND REFRESH APIS；一般保持当前默认值，仅在明确需要调优时修改。
# MARKET_DATA_BACKGROUND_REFRESH_APIS=managed in settings/platform_policy.json

# MARKET DATA BACKGROUND REFRESH WORKERS；一般保持当前默认值，仅在明确需要调优时修改。
# MARKET_DATA_BACKGROUND_REFRESH_WORKERS=managed in settings/platform_policy.json

# MARKET DATA REFRESH AHEAD 秒数；一般保持当前默认值，仅在明确需要调优时修改。
# MARKET_DATA_REFRESH_AHEAD_SECONDS=managed in settings/platform_policy.json

# MARKET DATA PREWARM 是否启用；一般保持当前默认值，仅在明确需要调优时修改。
MARKET_DATA_PREWARM_ENABLED=False

# MARKET DATA PREWARM DELAY 秒数；一般保持当前默认值，仅在明确需要调优时修改。
# MARKET_DATA_PREWARM_DELAY_SECONDS=managed in settings/platform_policy.json

# MARKET DATA PREWARM APIS；一般保持当前默认值，仅在明确需要调优时修改。
# MARKET_DATA_PREWARM_APIS=managed in settings/platform_policy.json

# ASYNC USAGE LOG 是否启用；一般保持当前默认值，仅在明确需要调优时修改。
ASYNC_USAGE_LOG_ENABLED=True

# USAGE LOG QUEUE SIZE；一般保持当前默认值，仅在明确需要调优时修改。
# USAGE_LOG_QUEUE_SIZE=managed in settings/platform_policy.json

# USAGE LOG FLUSH INTERVAL 秒数；一般保持当前默认值，仅在明确需要调优时修改。
USAGE_LOG_FLUSH_INTERVAL_SECONDS=1

# REALTIME CACHE 有效期 秒数；一般保持当前默认值，仅在明确需要调优时修改。
REALTIME_CACHE_TTL_SECONDS=1

# LOCAL CACHE PROMOTION 有效期 秒数；一般保持当前默认值，仅在明确需要调优时修改。
LOCAL_CACHE_PROMOTION_TTL_SECONDS=15

# USAGE LOG BATCH SIZE；一般保持当前默认值，仅在明确需要调优时修改。
USAGE_LOG_BATCH_SIZE=500

# USAGE LOG DROP ON FULL；一般保持当前默认值，仅在明确需要调优时修改。
USAGE_LOG_DROP_ON_FULL=True

# USAGE LOG SUCCESS SAMPLE RATE；一般保持当前默认值，仅在明确需要调优时修改。
USAGE_LOG_SUCCESS_SAMPLE_RATE=0.10

# USAGE LOG RETAIN FAILURES；一般保持当前默认值，仅在明确需要调优时修改。
USAGE_LOG_RETAIN_FAILURES=True

# USAGE LOG 保留天数；一般保持当前默认值，仅在明确需要调优时修改。
USAGE_LOG_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# 审计与日志
# ------------------------------------------------------------------------------
# AUDIT 是否启用；一般保持当前默认值，仅在明确需要调优时修改。
AUDIT_ENABLED=True

# API ACCESS LOG 保留天数；一般保持当前默认值，仅在明确需要调优时修改。
# API_ACCESS_LOG_RETENTION_DAYS=managed in settings/platform_policy.json

# OPERATION LOG 保留天数；一般保持当前默认值，仅在明确需要调优时修改。
OPERATION_LOG_RETENTION_DAYS=365

# AUDIT CLEANUP INTERVAL 小时S；一般保持当前默认值，仅在明确需要调优时修改。
AUDIT_CLEANUP_INTERVAL_HOURS=24

# 审计日志持久化缓冲数据库路径。
AUDIT_SPOOL_DB_FILE=data/audit_spool.db

# AUDIT SPOOL BATCH SIZE；一般保持当前默认值，仅在明确需要调优时修改。
# AUDIT_SPOOL_BATCH_SIZE=managed in settings/platform_policy.json

# AUDIT SPOOL FLUSH INTERVAL 秒数；一般保持当前默认值，仅在明确需要调优时修改。
# AUDIT_SPOOL_FLUSH_INTERVAL_SECONDS=managed in settings/platform_policy.json

# AUDIT SPOOL 最大 重试次数；一般保持当前默认值，仅在明确需要调优时修改。
